        },
        "issueQueueToken": {
          "type": "boolean",
          "default": false
        },
        "autoCloseSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "examples": [
    {
      "version": 2,
      "description": "Account request with face verification and submission-time field correction",
      "groups": {
        "identity": {
          "label": {
            "en": "Identity",
            "bn": "পরিচয়"
          },
          "sequence": 10
        },
        "address": {
          "label": {
            "en": "Address",
            "bn": "ঠিকানা"
          },
          "sequence": 20
        }
      },
      "contextSchema": {
        "customer.id": {
          "type": "string",
          "semanticType": "CUSTOMER_ID",
          "sensitive": true
        },
        "biometric.face.captureRef": {
          "type": "string",
          "semanticType": "BIOMETRIC_CAPTURE_REF",
          "sensitive": true,
          "persist": false
        },
        "biometric.face.verified": {
          "type": "boolean",
          "persist": false
        },
        "request.mothersMaidenName": {
          "type": "string",
          "sensitive": true
        },
        "request.address.postcode": {
          "type": "string"
        },
        "system.requestId": {
          "type": "string",
          "semanticType": "REQUEST_ID"
        }
      },
      "start": "capture_face",
      "nodes": {
        "capture_face": {
          "type": "input",
          "component": "biometric",
          "binding": "biometric.face.captureRef",
          "group": "identity",
          "presentation": {
            "title": {
              "en": "Verify your identity",
              "bn": "আপনার পরিচয় যাচাই করুন"
            },
            "subtitle": {
              "en": "Look directly at the camera"
            }
          },
          "input": {
            "biometric": {
              "modality": "face",
              "mode": "capture",
              "livenessRequired": true,
              "maxAttempts": 3,
              "captureFormat": "image_ref"
            }
          },
          "next": "verify_face"
        },
        "verify_face": {
          "type": "action",
          "operation": "verify_customer_face",
          "group": "identity",
          "request": {
            "customerId": "${customer.id}",
            "captureRef": "${biometric.face.captureRef}"
          },
          "result": {
            "biometric.face.verified": "$.verified"
          },
          "next": "mother_name",
          "onFailure": "biometric_error"
        },
        "mother_name": {
          "type": "input",
          "component": "text",
          "binding": "request.mothersMaidenName",
          "group": "identity",
          "presentation": {
            "title": {
              "en": "Mother's maiden name"
            }
          },
          "validation": [
            {
              "type": "required"
            }
          ],
          "next": "postcode"
        },
        "postcode": {
          "type": "input",
          "component": "text",
          "binding": "request.address.postcode",
          "group": "address",
          "presentation": {
            "title": {
              "en": "Postcode"
            }
          },
          "validation": [
            {
              "type": "required"
            }
          ],
          "next": "confirm"
        },
        "confirm": {
          "type": "confirmation",
          "summary": [
            {
              "label": {
                "en": "Mother's maiden name"
              },
              "value": "${request.mothersMaidenName}",
              "edit": {
                "binding": "request.mothersMaidenName"
              }
            },
            {
              "label": {
                "en": "Postcode"
              },
              "value": "${request.address.postcode}",
              "edit": {
                "group": "address"
              }
            }
          ],
          "next": "submit"
        },
        "submit": {
          "type": "submit",
          "operation": "submit_account_request",
          "request": "${request}",
          "result": {
            "system.requestId": "$.requestId"
          },
          "validationErrorHandling": {
            "mode": "field_correction",
            "singleErrorBehavior": "jump_to_field",
            "multipleErrorBehavior": "correction_queue",
            "returnTo": "confirm",
            "unknownFieldErrorTo": "submission_error",
            "clearErrorOnChange": true,
            "groupErrors": true
          },
          "onSuccess": "success",
          "onBusinessError": "submission_error",
          "onSystemError": "submission_error",
          "onFailure": "submission_error"
        },
        "success": {
          "type": "result",
          "variant": "success",
          "content": {
            "en": "Your request has been submitted."
          },
          "reference": "${system.requestId}"
        },
        "biometric_error": {
          "type": "result",
          "variant": "error",
          "content": {
            "en": "We could not verify your identity."
          }
        },
        "submission_error": {
          "type": "result",
          "variant": "error",
          "content": {
            "en": "We could not submit your request."
          }
        }
      }
    }
  ]
}
