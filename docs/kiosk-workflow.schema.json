          "$ref": "#/$defs/presentation"
        },
        "request": {
          "oneOf": [
            {
              "$ref": "#/$defs/valueMap"
            },
            {
              "$ref": "#/$defs/expression"
            }
          ]
        },
        "result": {
          "$ref": "#/$defs/resultMapping"
        },
